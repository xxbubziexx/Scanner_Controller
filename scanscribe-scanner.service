[Unit]
Description=Uniden Dual-Scanner Mutual Exclusion & ScanScribe Audio Feeder (Rust Engine)
After=network.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=scanscribe
Group=dialout
SupplementaryGroups=audio plugdev
WorkingDirectory=/opt/scanscribe-scanner
Environment="SCANSCRIBE_INBOX_DIR=/var/scanscribe/inbox"
Environment="SCANNER_A_PORT=/dev/ttyACM0"
Environment="SCANNER_B_PORT=/dev/ttyACM1"
Environment="RUST_LOG=info"
# Primary Rust single-binary daemon:
ExecStart=/opt/scanscribe-scanner/scanner-controller serve --host 0.0.0.0 --port 8000 --no-browser
# Instant Python rollback target (uncomment below and comment above, or run `./install.sh --rollback-python`):
# ExecStart=/opt/scanscribe-scanner/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
